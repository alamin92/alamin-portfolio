---
import { site, nav } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="container bar">
    <a class="brand" href="/">{site.name}</a>
    <div class="right">
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" id="sound-toggle" class="sound" aria-pressed="false" aria-label="Sound effects: off" title="Sound effects: off">
        <svg class="off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="m16 9 5 6M21 9l-5 6"/></svg>
        <svg class="on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { audio, soundOn, setSound } from '../scripts/sound';
  import { visitStart } from '../scripts/visit';

  visitStart(); // starts the "time on site" clock on whichever page someone lands on first

  const btn = document.getElementById('sound-toggle') as HTMLButtonElement | null;
  const paint = () => {
    if (!btn) return;
    const on = soundOn();
    const label = `Sound effects: ${on ? 'on' : 'off'}`;
    btn.setAttribute('aria-pressed', String(on));
    btn.setAttribute('aria-label', label);
    btn.title = label;
  };
  paint();
  btn?.addEventListener('click', () => {
    const on = !soundOn();
    setSound(on);
    paint();
    if (on) audio(); // lets the browser start audio; the switch itself makes no sound
  });

  // Browsers only start audio after a click, tap or key press. When the switch is on, quietly get
  // ready on the first one so the photo flip can make its soft sound. This plays nothing itself.
  const unlock = () => { if (soundOn()) audio(); };
  document.addEventListener('pointerdown', unlock, { passive: true });
  document.addEventListener('keydown', unlock, { passive: true });
</script>

<style>
  header { border-bottom: 1px solid var(--border); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .brand { font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
  .brand:hover { text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; margin: 0; padding: 0; }
  .right { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; }
  .sound {
    display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; padding: 0;
    border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--muted); cursor: pointer;
  }
  .sound:hover { color: var(--text); border-color: var(--area); }
  .sound .on { display: none; }
  .sound[aria-pressed='true'] { color: var(--area); border-color: var(--area); }
  .sound[aria-pressed='true'] .on { display: block; }
  .sound[aria-pressed='true'] .off { display: none; }
  nav a { color: var(--muted); font-size: 0.95rem; }
  nav a { padding-bottom: 2px; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--text); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--text); text-decoration: none; border-bottom-color: var(--area); }
</style>
