---
import Base from '../../layouts/Base.astro';

const tiles = [
  { id: 'owl', emoji: '🦉', name: 'Owl', note: 'Hoo, hoo-hoo, hooo' },
  { id: 'cricket', emoji: '🦗', name: 'Cricket', note: 'A summer night' },
  { id: 'frog', emoji: '🐸', name: 'Frog', note: 'Ribbit' },
  { id: 'drum', emoji: '🥁', name: 'Drum', note: 'A quick beat and a fill' },
  { id: 'dreamcatcher', emoji: '🪶', name: 'Dreamcatcher', note: 'A soft breeze and tiny bells' },
  { id: 'thunder', emoji: '⛈️', name: 'Thunder', note: 'A storm rolling in' },
];
---

<Base title="Sound board" description="A small sound board with an owl, a cricket, a frog, a drum, a dreamcatcher and thunder, all made from scratch with code.">
  <div class="page">
    <div class="container">
      <p><a href="/arcade">← Arcade</a></p>
      <h1>Sound board</h1>
      <p class="lead">Tap a tile to hear it: a few night creatures, a drum, a dreamcatcher and a storm.</p>

      <div class="grid">
        {tiles.map((c) => (
          <button type="button" class="card tile" data-sound={c.id} aria-label={`Play ${c.name}: ${c.note}`}>
            <span class="emoji" aria-hidden="true">{c.emoji}</span>
            <span class="name">{c.name}</span>
            <span class="note muted">{c.note}</span>
          </button>
        ))}
      </div>

      <p class="muted fine">
        These are not recordings. Every sound is made by a few lines of code, so think of them as
        cartoon impressions rather than the real thing. Turn your volume down a little first.
      </p>
    </div>
  </div>
</Base>

<script>
  import { initSoundBoard } from '../../scripts/soundboard';

  initSoundBoard(Array.from(document.querySelectorAll<HTMLElement>('.tile')));
</script>

<style>
  .tile {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;
    font: inherit; color: var(--text); cursor: pointer; padding: 22px 12px;
  }
  .emoji { font-size: 2.6rem; line-height: 1; }
  .name { font-weight: 700; font-size: 1.05rem; }
  .note { font-size: 0.85rem; }
  .playing .emoji { animation: bounce 0.6s ease; }
  @keyframes bounce {
    0%, 100% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-10px) scale(1.15); }
    60% { transform: translateY(0) scale(0.95); }
  }
  .fine { margin: 24px 0 0; font-size: 0.9rem; }
</style>
